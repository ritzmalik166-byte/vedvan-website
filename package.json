{
  "name": "vedvan",
  "private": true,
  "description": "Vedvan website — static HTML + Tailwind CSS",
  "scripts": {
    "build": "npm run vendor && tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "watch": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('js/vendor',{recursive:true});for(const f of ['gsap/dist/gsap.min.js','gsap/dist/ScrollTrigger.min.js','lenis/dist/lenis.min.js','lenis/dist/lenis.min.js.map'])fs.copyFileSync('node_modules/'+f,'js/vendor/'+f.split('/').pop())\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  }
}
